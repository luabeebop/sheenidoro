[Desktop Entry]
Name=Sheenidoro
Comment=Terminal-brutalist pomodoro — track focus and breaks
Exec=sheenidoro %U
Icon=sheenidoro
Type=Application
Categories=Utility;Productivity;
StartupWMClass=Sheenidoro
Terminal=false
GenericName=Pomodoro Timer
Keywords=pomodoro;timer;focus;break;productivity;
Actions=Toggle;Show;

[Desktop Action Toggle]
Name=Toggle Timer
Exec=sheenidoro --toggle

[Desktop Action Show]
Name=Show Window
Exec=sheenidoro --show
